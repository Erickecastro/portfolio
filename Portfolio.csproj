<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools/**/*.cs" />
    <RazorComponent Remove="tools/**/*.razor" />
    <Content Remove="wwwroot/index.html;wwwroot/projetos/droidko/index.html;wwwroot/projetos/transsend/index.html" />
    <Content Include="wwwroot/index.html;wwwroot/projetos/droidko/index.html;wwwroot/projetos/transsend/index.html" />
  </ItemGroup>
  <Target Name="GeneratePageMetadata" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(NetCoreRoot)dotnet&quot; run --project &quot;$(MSBuildProjectDirectory)/tools/GeneratePages/GeneratePages.csproj&quot; --no-launch-profile -- &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
</Project>
