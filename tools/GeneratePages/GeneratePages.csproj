<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Portfolio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Content/PortfolioContent.cs" Link="PortfolioContent.cs" />
    <Compile Include="../../Shared/ContactType.cs" Link="Shared/ContactType.cs" />
    <RazorComponent Include="../../Pages/Home.razor" Link="Pages/Home.razor" />
    <RazorComponent Include="../../Shared/*.razor" Link="Shared/%(Filename)%(Extension)" />
    <RazorComponent Include="../../Layout/MainLayout.razor" Link="Layout/MainLayout.razor" />
    <RazorComponent Include="../../_Imports.razor" Link="_Imports.razor" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
